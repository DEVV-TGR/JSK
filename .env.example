# Copia para .env.local e preenche. O .env.local nunca vai para o repositório.

# O endereço público do site. Em produção, https://jsk.pt.
# Numa pré-visualização da Vercel, põe o URL da pré-visualização — senão os
# URLs canónicos e o sitemap apontam para o site a sério e é a pré-visualização
# a competir com ele nos resultados de pesquisa.
NEXT_PUBLIC_SITE_URL=https://jsk.pt

# ── Entrega do formulário de orçamento ────────────────────────────────────
# ⚠️ AINDA NÃO ESTÁ LIGADO. Enquanto CONTACTO_PROVEDOR estiver vazio, a rota
# /api/contacto responde 503 e o formulário diz ao visitante para telefonar ou
# escrever directamente. Nunca finge que enviou.
#
# Valores possíveis: resend | formspree | (vazio)
CONTACTO_PROVEDOR=

# A caixa que recebe os pedidos de orçamento. Por omissão, o site.email.
CONTACTO_DESTINO=

# Se CONTACTO_PROVEDOR=resend — cria a chave em https://resend.com/api-keys e
# põe a mesma nas Environment Variables do projecto na Vercel.
# RESEND_API_KEY=

# Se CONTACTO_PROVEDOR=formspree — o ID do formulário (a parte final do URL).
# FORMSPREE_ID=
