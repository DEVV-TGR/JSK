# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependências
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testes
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# produção
/build

# diversos
.DS_Store
*.pem

# depuração
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# variáveis de ambiente
.env*
# excepção: o .env.example não tem segredo nenhum — é a lista do que é preciso
# configurar. Sem esta linha o padrão acima apanhava-o.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Originais dos assets do cliente, tal como saem de jsk.pt: uns 7,5 MB de PNG e
# JPEG que ninguém precisa de versionar. O que vai para o site são os derivados
# em public/, gerados por `npm run assets`. Ver docs/assets.md.
/originais/

# agentes — o .claude/settings.json e o .claude/skills/ SÃO versionados de
# propósito: a configuração e as skills viajam com o repositório, para que
# funcionem noutra máquina. Só fica de fora o que é da máquina de cada um.
/.claude/settings.local.json
/.claude/worktrees/
